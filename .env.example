# Copier ce fichier en .env et remplir les valeurs. Ne JAMAIS committer .env.

# --- Modèle -----------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
MODEL_SECOURS=claude-sonnet-5-5

# --- Boucle de l'agent ------------------------------------------------------
EFFORT=medium
MAX_ETAPES=12
MAX_TOKENS_PAR_EMAIL=30000
MAX_TOKENS_REPONSE=16000
CHECKPOINT_DB=data/checkpoints.sqlite
TRACES_DIR=traces/brutes

# --- Catalogue / serveur MCP ------------------------------------------------
CATALOGUE_DB=data/catalogue.sqlite
# stdio : l'agent lance le serveur lui-même ; http : se connecte à MCP_URL
MCP_TRANSPORT=stdio
MCP_URL=http://127.0.0.1:8000/mcp

# --- Google (compte de test uniquement) -------------------------------------
GOOGLE_CREDENTIALS=secrets/credentials.json
GOOGLE_TOKEN=secrets/token.json
AGENCE_EMAIL=agence.test@example.com
CALENDAR_ID_AMINATA=
CALENDAR_ID_MOUSSA=
CALENDAR_ID_KHADY=
